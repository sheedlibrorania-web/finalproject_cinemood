<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_pressed="true"><shape><solid android:color="@color/cm_surface"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/cm_accent"/></shape></item>
            <item android:state_focused="true"><shape><solid android:color="@color/cm_surface"/><corners android:radius="14dp"/><stroke android:width="2dp" android:color="@color/cm_accent"/></shape></item>
            <item><shape><solid android:color="@color/cm_surface"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/cm_border"/></shape></item>
        </selector>
    </item>
    <item android:drawable="@drawable/ic_cm_chevron_down" android:width="20dp" android:height="20dp" android:gravity="end|center_vertical" android:end="16dp" />
</layer-list>
