<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector android:enterFadeDuration="180" android:exitFadeDuration="180">
            <item android:state_enabled="false"><shape><solid android:color="#3D3B40"/><corners android:radius="16dp"/></shape></item>
            <item android:state_hovered="true"><shape><solid android:color="#FFDAC0"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#FFE7D6"/></shape></item>
            <item android:state_focused="true"><shape><solid android:color="#FFDAC0"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#FFE7D6"/></shape></item>
            <item><shape><solid android:color="@color/cm_accent"/><corners android:radius="16dp"/></shape></item>
        </selector>
    </item>
</ripple>
