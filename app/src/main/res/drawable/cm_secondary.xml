<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector android:enterFadeDuration="180" android:exitFadeDuration="180">
            <item android:state_enabled="false"><shape><solid android:color="#151A27"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#252C3B"/></shape></item>
            <item android:state_selected="true"><shape><solid android:color="#443751"/><stroke android:color="@color/cm_lilac" android:width="2dp"/><corners android:radius="16dp"/></shape></item>
            <item android:state_hovered="true"><shape><solid android:color="#2A3148"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/cm_lilac"/></shape></item>
            <item android:state_focused="true"><shape><solid android:color="#2A3148"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/cm_lilac"/></shape></item>
            <item><shape><solid android:color="@color/cm_surface"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/cm_border"/></shape></item>
        </selector>
    </item>
</ripple>
