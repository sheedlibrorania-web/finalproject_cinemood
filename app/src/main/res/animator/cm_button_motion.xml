<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationY" android:valueTo="0dp" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </set>
    </item>
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.985" android:valueType="floatType" android:duration="110" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.985" android:valueType="floatType" android:duration="110" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationY" android:valueTo="0dp" android:valueType="floatType" android:duration="110" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="1dp" android:valueType="floatType" android:duration="110" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </set>
    </item>
    <item android:state_hovered="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.015" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.015" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationY" android:valueTo="-2dp" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </set>
    </item>
    <item android:state_focused="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.015" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.015" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationY" android:valueTo="-2dp" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </set>
    </item>
    <item >
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="220" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="220" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationY" android:valueTo="0dp" android:valueType="floatType" android:duration="220" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" android:duration="220" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </set>
    </item>
</selector>
