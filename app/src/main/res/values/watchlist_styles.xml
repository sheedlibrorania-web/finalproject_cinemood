<resources>
    <style name="CM.WatchlistDropdown" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/cm_dropdown_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:dropDownWidth">match_parent</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:popupBackground">@drawable/cm_dropdown_popup</item>
    </style>
    <string name="watchlist_search_hint">Search saved movies</string>
    <string name="watchlist_filter_description">Filter watchlist by status</string>
    <string name="watchlist_sort_description">Sort watchlist</string>
    <string-array name="watchlist_filters"><item>All movies</item><item>To watch</item><item>Watched</item></string-array>
    <string-array name="watchlist_sort_orders"><item>Newest saved</item><item>Title A–Z</item><item>Release year</item></string-array>
</resources>
