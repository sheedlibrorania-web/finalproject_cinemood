<resources>
<style name="Theme.CineMood" parent="Theme.AppCompat.Light.NoActionBar">
<item name="android:fontFamily">sans-serif</item><item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item><item name="android:windowBackground">@color/cm_background</item><item name="android:statusBarColor">@color/cm_background</item><item name="android:navigationBarColor">@color/cm_background</item><item name="colorAccent">@color/cm_accent</item><item name="android:colorControlActivated">@color/cm_accent</item></style>
<style name="CM"/>
<style name="CM.InputIcon" parent="Widget.AppCompat.ImageButton">
    <item name="android:stateListAnimator">@animator/cm_button_motion</item>
    <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:padding">12dp</item>
    <item name="android:scaleType">centerInside</item>
</style>
<style name="CM.PasswordToggle" parent="CM.InputIcon" />
<style name="CM.Scroll">
    <item name="android:scrollbars">vertical</item>
    <item name="android:fadeScrollbars">false</item>
    <item name="android:scrollbarSize">3dp</item>
    <item name="android:scrollbarThumbVertical">@color/cm_lilac</item>
    <item name="android:scrollbarStyle">insideOverlay</item>
    <item name="android:overScrollMode">ifContentScrolls</item>
    <item name="android:focusableInTouchMode">true</item>
</style>
<style name="CM.Body"><item name="android:textColor">@color/cm_muted</item><item name="android:textSize">15sp</item><item name="android:lineSpacingExtra">5dp</item><item name="android:layout_marginBottom">16dp</item></style>
<style name="CM.Brand" parent="CM.Body"><item name="android:textColor">@color/cm_accent</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.22</item><item name="android:layout_marginBottom">24dp</item></style>
<style name="CM.Title" parent="CM.Body"><item name="android:textColor">@color/cm_text</item><item name="android:textSize">36sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">-0.035</item><item name="android:lineSpacingExtra">0dp</item><item name="android:layout_marginBottom">12dp</item></style>
<style name="CM.Section" parent="CM.Title"><item name="android:textSize">21sp</item><item name="android:layout_marginTop">12dp</item></style>
<style name="CM.Label" parent="CM.Body"><item name="android:textSize">12sp</item><item name="android:textColor">@color/cm_lilac</item><item name="android:letterSpacing">0.1</item><item name="android:textStyle">bold</item><item name="android:layout_marginBottom">10dp</item></style>
<style name="CM.Card"><item name="android:orientation">vertical</item><item name="android:background">@drawable/cm_card</item><item name="android:padding">22dp</item><item name="android:layout_marginBottom">20dp</item></style>
<style name="CM.Button" parent="Widget.AppCompat.Button"><item name="android:background">@drawable/cm_button</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/cm_on_accent</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:minHeight">56dp</item><item name="android:padding">16dp</item><item name="android:layout_marginBottom">12dp</item><item name="android:stateListAnimator">@animator/cm_button_motion</item></style>
<style name="CM.Secondary" parent="CM.Button"><item name="android:background">@drawable/cm_secondary</item><item name="android:textColor">@color/cm_text</item></style>
<style name="CM.Quiet" parent="CM.Secondary"><item name="android:background">@drawable/cm_quiet</item><item name="android:textColor">@color/cm_muted</item></style>
<style name="CM.Mood" parent="CM.Secondary"><item name="android:minHeight">72dp</item><item name="android:layout_margin">5dp</item><item name="android:padding">10dp</item></style>
<style name="CM.Input" parent="Widget.AppCompat.EditText"><item name="android:textColor">@color/cm_text</item><item name="android:textColorHint">@color/cm_muted</item><item name="android:textSize">16sp</item><item name="android:background">@drawable/cm_input</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item><item name="android:minHeight">56dp</item><item name="android:padding">16dp</item><item name="android:layout_marginBottom">16dp</item></style>
</resources>
