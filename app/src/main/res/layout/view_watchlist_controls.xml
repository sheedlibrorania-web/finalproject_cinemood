<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
    <EditText android:id="@+id/etWatchlistSearch" style="@style/CM.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/watchlist_search_hint" android:contentDescription="@string/watchlist_search_hint" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Spinner android:id="@+id/spinnerWatchlistFilter" style="@style/CM.WatchlistDropdown" android:layout_width="0dp" android:layout_height="wrap_content" android:contentDescription="@string/watchlist_filter_description" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <Spinner android:id="@+id/spinnerWatchlistSort" style="@style/CM.WatchlistDropdown" android:layout_width="0dp" android:layout_height="wrap_content" android:contentDescription="@string/watchlist_sort_description" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>