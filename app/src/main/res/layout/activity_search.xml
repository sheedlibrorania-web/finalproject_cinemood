<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CM.Scroll" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
        <TextView style="@style/CM.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CineMood" android:textSize="20sp" android:letterSpacing="-0.02" android:textColor="@color/cm_text" android:layout_marginBottom="20dp" />
        <TextView style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find your next film." android:textSize="32sp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Big adventures. Quiet moments. Start with a title." />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEARCH THE COLLECTION" />
            <EditText style="@style/CM.Input" android:id="@+id/etQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Try Interstellar…" android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" />
            <Button style="@style/CM.Button" android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find a film  →" />
        </LinearLayout>
        <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The collection" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/tvResultCount" />
        <LinearLayout android:id="@+id/movieContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <Button style="@style/CM.Quiet" android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="←  Back to my space" android:gravity="start|center_vertical" android:paddingStart="0dp" android:minHeight="48dp" android:layout_marginBottom="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>