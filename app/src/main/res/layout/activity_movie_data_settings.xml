<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screenRoot" style="@style/CM.Scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvDataTitle" style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_title" />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/tvDataMode" style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
            <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_help" />
            <EditText android:id="@+id/etTmdbToken" style="@style/CM.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/data_token_hint" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
            <Button android:id="@+id/btnSaveToken" style="@style/CM.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_save_token" />
            <Button android:id="@+id/btnSampleMode" style="@style/CM.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_use_sample" />
        </LinearLayout>
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_credits_title" />
            <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_credits" android:autoLink="web" />
        </LinearLayout>
        <Button android:id="@+id/btnBack" style="@style/CM.Quiet" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_back" android:gravity="start|center_vertical" android:paddingStart="0dp" android:paddingEnd="16dp" android:minHeight="48dp" android:layout_marginBottom="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
