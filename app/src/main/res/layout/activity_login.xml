<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CM.Scroll" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
        <TextView style="@style/CM.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_cinemood" android:textSize="20sp" android:letterSpacing="-0.02" android:textColor="@color/cm_text" android:layout_marginBottom="20dp" />
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="start" android:src="@drawable/cm_reel" android:importantForAccessibility="no" android:layout_marginBottom="12dp" />
        <TextView style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_a_film_for_every_feeling" android:textSize="30sp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_find_your_next_favourite_keep_the_stories_that_stay_wit" />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_welcome_back" />
            <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_your_movie_night_starts_here" />
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_username" />
            <EditText style="@style/CM.Input" android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ui_your_username" android:inputType="text" android:autofillHints="username" android:singleLine="true" />
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_password" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <EditText style="@style/CM.Input" android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ui_your_password" android:inputType="textPassword" android:autofillHints="password" android:singleLine="true" android:layout_marginBottom="0dp" android:paddingStart="16dp" android:paddingEnd="64dp" />
                <ImageButton style="@style/CM.PasswordToggle" android:id="@+id/btnTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:contentDescription="@string/show_password" android:src="@drawable/ic_password_show" android:visibility="invisible" />
            </FrameLayout>
            <Button style="@style/CM.Button" android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_enter_your_movie_space" />
            <Button style="@style/CM.Secondary" android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_create_an_account" />
        </LinearLayout>
        <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_discover_feel_remember" android:gravity="center" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>