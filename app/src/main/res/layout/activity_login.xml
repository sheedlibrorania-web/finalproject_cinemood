<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CM.Scroll" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
        <TextView style="@style/CM.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CineMood" android:textSize="20sp" android:letterSpacing="-0.02" android:textColor="@color/cm_text" android:layout_marginBottom="20dp" />
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="start" android:src="@drawable/cm_reel" android:importantForAccessibility="no" android:layout_marginBottom="12dp" />
        <TextView style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A film for every feeling." android:textSize="30sp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find your next favourite. Keep the stories that stay with you." />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome back" />
            <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your movie night starts here." />
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USERNAME" />
            <EditText style="@style/CM.Input" android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Your username" android:inputType="text" android:autofillHints="username" android:singleLine="true" />
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PASSWORD" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <EditText style="@style/CM.Input" android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Your password" android:inputType="textPassword" android:autofillHints="password" android:singleLine="true" android:layout_marginBottom="0dp" android:paddingEnd="64dp" />
                <ImageButton style="@style/CM.PasswordToggle" android:id="@+id/btnTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:contentDescription="@string/show_password" android:src="@drawable/ic_password_show" android:visibility="invisible" />
            </FrameLayout>
            <Button style="@style/CM.Button" android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enter your movie space  →" />
            <Button style="@style/CM.Secondary" android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create an account" />
        </LinearLayout>
        <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DISCOVER  ·  FEEL  ·  REMEMBER" android:gravity="center" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>