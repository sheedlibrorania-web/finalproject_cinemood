<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CM.Scroll" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true" android:clipToPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
        <TextView style="@style/CM.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_cinemood" android:textSize="20sp" android:letterSpacing="-0.02" android:textColor="@color/cm_text" android:layout_marginBottom="20dp" />
        <TextView style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_your_movie_story_starts_here" android:textSize="30sp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_a_little_space_for_all_the_films_you_love" />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_create_your_account" />
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_username" />
            <EditText style="@style/CM.Input" android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ui_choose_a_username" android:inputType="text" android:autofillHints="newUsername" android:singleLine="true" />
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_password" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <EditText style="@style/CM.Input" android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/password_registration_hint" android:inputType="textPassword" android:autofillHints="newPassword" android:singleLine="true" android:layout_marginBottom="0dp" android:paddingStart="16dp" android:paddingEnd="64dp" />
                <ImageButton style="@style/CM.PasswordToggle" android:id="@+id/btnTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:contentDescription="@string/show_password" android:src="@drawable/ic_password_show" android:visibility="invisible" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <EditText style="@style/CM.Input" android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ui_confirm_your_password" android:inputType="textPassword" android:autofillHints="newPassword" android:singleLine="true" android:layout_marginBottom="0dp" android:paddingStart="16dp" android:paddingEnd="64dp" />
                <ImageButton style="@style/CM.PasswordToggle" android:id="@+id/btnToggleConfirmPassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:contentDescription="@string/show_confirm_password" android:src="@drawable/ic_password_show" android:visibility="invisible" />
            </FrameLayout>
            <Button style="@style/CM.Button" android:id="@+id/btnCreateAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_start_my_movie_journey" />
        </LinearLayout>
        <Button style="@style/CM.Quiet" android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_back_to_sign_in" android:gravity="start|center_vertical" android:paddingStart="0dp" android:paddingEnd="16dp" android:minHeight="48dp" android:layout_marginBottom="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>