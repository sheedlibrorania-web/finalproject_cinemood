<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CM.Scroll" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true" android:clipToPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
        <TextView style="@style/CM.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_cinemood" android:textSize="20sp" android:letterSpacing="-0.02" android:textColor="@color/cm_text" android:layout_marginBottom="20dp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_welcome_back" android:id="@+id/tvWelcome" />
        <TextView style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_what_feels_good_tonight" android:textSize="32sp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_less_scrolling_more_stories_worth_watching" />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/cm_hero" android:padding="24dp">
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_the_mood_edit" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/CM.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_follow_your_feeling" android:textSize="30sp" android:layout_weight="1" />
                <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal" android:src="@drawable/cm_reel" android:importantForAccessibility="no" android:layout_marginBottom="0dp" android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_a_little_joy_a_little_suspense_a_whole_new_world" />
            <Button style="@style/CM.Button" android:id="@+id/btnMood" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_find_my_mood" />
        </LinearLayout>
        <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_make_it_a_movie_night" />
        <Button style="@style/CM.Secondary" android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_search_the_collection" android:gravity="start|center_vertical" android:minHeight="72dp" />
        <Button style="@style/CM.Secondary" android:id="@+id/btnWatchlist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_open_my_watchlist" android:gravity="start|center_vertical" android:minHeight="72dp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_save_a_title_today_find_your_next_favourite_tomorrow" android:paddingTop="12dp" />
        <Button style="@style/CM.Quiet" android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_log_out" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>