<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CM.Scroll" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cm_backdrop" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
        <TextView style="@style/CM.Brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CineMood" android:textSize="20sp" android:letterSpacing="-0.02" android:textColor="@color/cm_text" android:layout_marginBottom="20dp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome back" android:id="@+id/tvWelcome" />
        <TextView style="@style/CM.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="What feels good tonight?" android:textSize="32sp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Less scrolling. More stories worth watching." />
        <LinearLayout style="@style/CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/cm_hero" android:padding="24dp">
            <TextView style="@style/CM.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="THE MOOD EDIT" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/CM.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Follow your feeling." android:textSize="30sp" android:layout_weight="1" />
                <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal" android:src="@drawable/cm_reel" android:importantForAccessibility="no" android:layout_marginBottom="0dp" android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A little joy. A little suspense. A whole new world." />
            <Button style="@style/CM.Button" android:id="@+id/btnMood" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find my mood  →" />
        </LinearLayout>
        <TextView style="@style/CM.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Make it a movie night" />
        <Button style="@style/CM.Secondary" android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌕   Search the collection" android:gravity="start|center_vertical" android:minHeight="72dp" />
        <Button style="@style/CM.Secondary" android:id="@+id/btnWatchlist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="＋   Open my watchlist" android:gravity="start|center_vertical" android:minHeight="72dp" />
        <TextView style="@style/CM.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save a title today. Find your next favourite tomorrow." android:paddingTop="12dp" />
        <Button style="@style/CM.Quiet" android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Log out" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>